<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net8.0 as well as net10.0: nothing here needs anything newer than .NET 8, and a host
             still on an LTS runtime should not have to upgrade to register a despatch. -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>ForEach.Infrastructure.External.eOtpremnica</RootNamespace>

        <!-- The doc comments are the library's manual; without this file none of them reach a
             consumer's IntelliSense. A public member without one is a build warning on purpose. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet-ready from day one; packing is a CI step rather than a build step. -->
        <PackageId>ForEach.Infrastructure.External.eOtpremnica</PackageId>
        <Version>0.1.0</Version>
        <Description>Client and UBL 2.1 Despatch Advice writer for the Serbian central register of electronic delivery notes (eOtpremnica).</Description>
        <PackageTags>eOtpremnica;UBL;DespatchAdvice;Serbia;mfin</PackageTags>
        <PackageProjectUrl>https://github.com/foreach-rs/eOtpremnica</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Validates that both target frameworks expose the same API. Once a version is
             published, set <PackageValidationBaselineVersion> to it so a breaking change against
             the released API fails the build instead of surprising a consumer. -->
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <InternalsVisibleTo Include="ForEach.Infrastructure.External.eOtpremnica.UnitTests" />
    </ItemGroup>

    <!--
        No project references and no packages, the same rule the Nbs library states: it knows
        nothing about HRC — not its entities, not FluentResults, not its settings binder. A
        dependency on any of those would make "reusable in another solution" a claim rather than a
        fact. System.Net.Http.Json and System.Text.Json ship with the framework; the day this
        project needs a package is the day to ask why.
    -->

</Project>
