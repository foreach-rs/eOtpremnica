<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One source, stated here, so a restore is the same on every machine and on CI: a developer
       whose user-level config adds private feeds does not get a different dependency graph, and
       central package management stops warning (NU1507) about mapping several sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
